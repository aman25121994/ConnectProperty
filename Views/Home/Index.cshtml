@model List<Property>
@{
    ViewData["Title"] = "Browse Listings";
    string? search = ViewData["Search"] as string;
    int total = (int)(ViewData["Total"] ?? 0);
}

<section class="hero">
    <div class="container">
        <h1>Find your next home in Addis Ababa</h1>
        <p>Browse current listings shared internally — no account needed.</p>

        <form class="search-bar" method="get" action="/">
            <input type="text" name="search" placeholder="Search by title, neighborhood, or description…" value="@search" />
            <button type="submit" class="btn btn-primary">Search</button>
        </form>

        <div class="hero-stats">
            <div><strong>@total</strong> listing@(total == 1 ? "" : "s") @(string.IsNullOrWhiteSpace(search) ? "available" : $"matching \"{search}\"")</div>
        </div>
    </div>
</section>

<div class="container">
    @if (Model.Count == 0)
    {
        <div class="empty-state">
            <div class="icon">🏠</div>
            <h3>No listings found</h3>
            <p>
                @if (!string.IsNullOrWhiteSpace(search))
                {
                    <span>Try a different search term, or <a href="/" style="color:var(--gold-500);font-weight:600;">clear the search</a>.</span>
                }
                else
                {
                    <span>Check back soon — new listings are added regularly.</span>
                }
            </p>
        </div>
    }
    else
    {
        <div class="listing-grid">
            @foreach (var p in Model)
            {
                <a class="card" href="/Home/Details/@p.Id" style="color:inherit;">
                    <div class="card-photo">
                        @if (!string.IsNullOrEmpty(p.ImagePath))
                        {
                            <img src="@p.ImagePath" alt="@p.Title" />
                        }
                        else
                        {
                            <div class="placeholder">🏡</div>
                        }
                        <div class="price-badge">ETB @p.Price.ToString("N0") / mo</div>
                    </div>
                    <div class="card-body">
                        <div class="card-title">@p.Title</div>
                        <div class="card-location">📍 @p.Location</div>
                        <div class="card-meta">
                            <span>🛏 @p.Bedrooms bed</span>
                            <span>🛁 @p.Bathrooms bath</span>
                        </div>
                        <div class="card-cta">
                            <span class="btn btn-outline btn-sm btn-block">View details</span>
                        </div>
                    </div>
                </a>
            }
        </div>
    }
</div>
